{"expect":{"v":1,"t":"event","id":2,"event":"planStep","stepIndex":0,"jobId":40,"payload":{"bodyEvents":[]}}}
{"expect":{"v":1,"t":"event","id":2,"event":"planStep","stepIndex":1,"jobId":40,"payload":{"bodyEvents":[{"kind":"created","bodyId":"body_op1"}]}}}
{"expect":{"v":1,"t":"resp","id":2,"ok":true,"jobId":40,"result":{"planPrepared":true,"lastValidStep":1,"stoppedReason":"completed","perStepResults":[{"stepIndex":0,"status":"ok"},{"stepIndex":1,"status":"ok","bodyIds":["body_op1"]}],"historyPrefixHash":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}}}
{"send":{"v":1,"t":"req","id":3,"verb":"AcceptPrepared","args":{"jobId":40,"documentRevision":1,"workerEpoch":4}}}
{"expect":{"v":1,"t":"resp","id":3,"ok":true,"jobId":40,"result":{"accepted":true,"snapshotId":1,"documentRevision":1}}}
# Plan 2 — r = 7 re-mints every id, so the SAME regionId now matches no cell.
{"send":{"v":1,"t":"req","id":4,"verb":"ExecutePlan","args":{"jobId":41,"documentRevision":2,"workerEpoch":4,"expectedBaseHash":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","prefixHashes":["cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc","dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"],"targetStep":1,"ops":[{"opType":"Sketch","opId":"op0","stepIndex":0,"params":{"sketchId":"sk","plane":{"kind":"XY"},"entities":[{"id":"l1","type":"Line","p0":[0,0],"p1":[40,0]},{"id":"l2","type":"Line","p0":[40,0],"p1":[40,20]},{"id":"l3","type":"Line","p0":[40,20],"p1":[0,20]},{"id":"l4","type":"Line","p0":[0,20],"p1":[0,0]},{"id":"c1","type":"Circle","center":[40,10],"radius":7}],"constraints":[]}},{"opType":"Extrude","opId":"op1","stepIndex":1,"params":{"sketchId":"sk","regionId":"r_b3ee587515654da7","regionIdentityVersion":3,"regionAnchor":[10.0,10.0],"distance":10.0,"extrudeMode":"Blind","booleanMode":"NewBody"}}]}}}
