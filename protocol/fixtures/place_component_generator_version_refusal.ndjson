# CANONICAL §7.3 fixture — the generator version pin is ENFORCED by the worker.
# `iso4762` builds at `generatorVersion` 1 only. Version 2 and an ABSENT version are
# recoverable step failures with top-level code `UNSUPPORTED` whose message names the
# generator id, the requested version and the supported one — raised before any
# geometry is built, so nothing is published and the head does not move. Version 1
# is the positive control. (Rust always serialises a u32 `generatorVersion`; the
# absent leg pins the worker's own defence for a hand-edited or foreign document.)
{"expect":{"v":1,"t":"hello","seq":0}}
{"send":{"v":1,"t":"req","id":1,"verb":"OpenSession","args":{"documentId":"doc_generator_version_refusal","documentRevision":0,"workerEpoch":4,"mode":"determinism"}}}
{"expect":{"v":1,"t":"resp","id":1,"ok":true,"result":{"sessionOpen":true}}}
