{"expect":{"v":1,"t":"resp","id":2,"ok":true,"jobId":111,"result":{"planPrepared":true,"lastValidStep":null,"stoppedReason":"opFailed","perStepResults":[{"stepIndex":0,"status":"opFailed","message":"$present","diagnostics":[{"severity":"error","code":"UNSUPPORTED","stage":"build","message":"$present"}]}]}}}
