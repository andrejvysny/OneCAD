{"send": {"v": 1, "t": "req", "id": 8, "verb": "DiscardPrepared", "args": {"jobId": 83}}}
{"expect": {"v": 1, "t": "resp", "id": 8, "ok": true, "jobId": 83, "result": {"discarded": true}}}
# (d) overflow outside {none,auto}: refused by name
{"send": {"v": 1, "t": "req", "id": 9, "verb": "ExecutePlan", "args": {"jobId": 84, "documentRevision": 2, "workerEpoch": 4, "expectedBaseHash": "2222222222222222222222222222222222222222222222222222222222222222", "prefixHashes": ["3333333333333333333333333333333333333333333333333333333333333333"], "targetStep": 2, "ops": [{"opType": "Fillet", "opId": "op2", "stepIndex": 2, "inputs": [{"primary": {"bodyId": "body_op1", "elementId": "el_top_edge", "kind": "edge"}, "anchor": {"worldPoint": [0.0, 15.0, 4.0]}}], "params": {"mode": "Fillet", "radius": 11.2, "edgeIds": ["el_top_edge"], "chainTangentEdges": true, "tangentClosureVersion": 1, "targetBodyId": "body_op1", "overflow": "bogus"}}]}}}
