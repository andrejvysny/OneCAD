# CANONICAL fixture - SCHEMA §7.3 Fillet/Chamfer `overflow` + `overflowVersion`
# (Overflow, Shapr3D Auto parity, 2026-11-01) and §7.2 warnings
# `FILLET_OVERFLOW_TRIMMED` / `CHAMFER_OVERFLOW_TRIMMED`.
#
# A 20 x 30 x 4 box (the XY sketch maps u->Y, v->-X, so the sketch rectangle is
# 30 x 20 and the body spans x in [-20,0], y in [0,30]); the seed is the top edge whose vertices sit at x=0, z=4.
# Native OCCT refuses a fillet radius >= 4 or a chamfer distance >= 4 there (the
# blend exceeds the 4 mm side face). With `overflow:"auto"` + `overflowVersion:1`
# the worker consumes the side face and trims the next one.
#   (a) fillet r=11.2, auto  => ok, warning FILLET_OVERFLOW_TRIMMED, kind "cliff"
#   (b) same r, no field     => opFailed, native diagnostic FILLET_START_SOLUTION_FAILED
#                               (native-only, as before; no overflow diagnostic)
#   (c) chamfer 6.2, auto    => ok, warning CHAMFER_OVERFLOW_TRIMMED, "extendedPlane"
#   (d) overflow "bogus"     => opFailed OP_FAILED naming `overflow`
#   (e) overflowVersion 2^32+1 => opFailed OP_FAILED (not narrowed to 1)
#   (f) fillet r=52.5, auto   => opFailed; native error diagnostic, then
#                               EDGE_OP_OVERFLOW_UNSUPPORTED/OVERFLOW_BOTH_SUPPORTS_CONSUMED
# Measurements (setback, volumes, face ordinals) are `$any`: json_subset compares
# numbers exactly and the closed-form pins live in test_blend_overflow.cpp.
{"expect": {"v": 1, "t": "hello", "seq": 0}}
{"send": {"v": 1, "t": "req", "id": 1, "verb": "OpenSession", "args": {"documentId": "doc_fillet_overflow", "documentRevision": 0, "workerEpoch": 4, "mode": "determinism"}}}
{"expect": {"v": 1, "t": "resp", "id": 1, "ok": true, "result": {"sessionOpen": true}}}
{"send": {"v": 1, "t": "req", "id": 2, "verb": "ExecutePlan", "args": {"jobId": 80, "documentRevision": 1, "workerEpoch": 4, "expectedBaseHash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "prefixHashes": ["1111111111111111111111111111111111111111111111111111111111111111", "2222222222222222222222222222222222222222222222222222222222222222"], "targetStep": 1, "ops": [{"opType": "Sketch", "opId": "op0", "stepIndex": 0, "params": {"sketchId": "sk1", "plane": {"kind": "XY"}, "entities": [{"id": "l1", "type": "Line", "p0": [0, 0], "p1": [30, 0]}, {"id": "l2", "type": "Line", "p0": [30, 0], "p1": [30, 20]}, {"id": "l3", "type": "Line", "p0": [30, 20], "p1": [0, 20]}, {"id": "l4", "type": "Line", "p0": [0, 20], "p1": [0, 0]}], "constraints": []}}, {"opType": "Extrude", "opId": "op1", "stepIndex": 1, "inputs": [], "params": {"sketchId": "sk1", "distance": 4, "booleanMode": "NewBody", "extrudeMode": "Blind"}}]}}}
{"expect": {"v": 1, "t": "event", "id": 2, "event": "planStep", "stepIndex": 0, "jobId": 80, "payload": {"bodyEvents": []}}}
{"expect": {"v": 1, "t": "event", "id": 2, "event": "planStep", "stepIndex": 1, "jobId": 80, "payload": {"bodyEvents": [{"kind": "created", "bodyId": "body_op1"}]}}}
{"expect": {"v": 1, "t": "resp", "id": 2, "ok": true, "jobId": 80, "result": {"planPrepared": true, "lastValidStep": 1, "stoppedReason": "completed"}}}
# (a) fillet r=11.2, overflow auto: native refuses, cliff overflow publishes with warning
{"send": {"v": 1, "t": "req", "id": 100, "verb": "AcceptPrepared", "args": {"jobId": 80, "documentRevision": 1, "workerEpoch": 4}}}
{"expect": {"v": 1, "t": "resp", "id": 100, "ok": true, "jobId": 80, "result": {"accepted": true, "snapshotId": 1, "documentRevision": 1}}}
{"send": {"v": 1, "t": "req", "id": 3, "verb": "ExecutePlan", "args": {"jobId": 81, "documentRevision": 2, "workerEpoch": 4, "expectedBaseHash": "2222222222222222222222222222222222222222222222222222222222222222", "prefixHashes": ["3333333333333333333333333333333333333333333333333333333333333333"], "targetStep": 2, "ops": [{"opType": "Fillet", "opId": "op2", "stepIndex": 2, "inputs": [{"primary": {"bodyId": "body_op1", "elementId": "el_top_edge", "kind": "edge"}, "anchor": {"worldPoint": [0.0, 15.0, 4.0]}}], "params": {"mode": "Fillet", "radius": 11.2, "edgeIds": ["el_top_edge"], "chainTangentEdges": true, "tangentClosureVersion": 1, "targetBodyId": "body_op1", "overflow": "auto", "overflowVersion": 1}}]}}}
{"expect": {"v": 1, "t": "event", "id": 3, "event": "planStep", "stepIndex": 2, "jobId": 81, "payload": {"bodyEvents": [{"kind": "modified", "bodyId": "body_op1"}], "diagnostics": [{"severity": "warning", "code": "FILLET_OVERFLOW_TRIMMED", "stage": "publication", "message": "$any", "evidence": {"overflowKind": "cliff", "consumedFace": "$any", "survivingSupport": "$any", "setback": "$any", "analyticRemovedVolume": "$any", "measuredRemovedVolume": "$any"}}]}}}
{"expect": {"v": 1, "t": "resp", "id": 3, "ok": true, "jobId": 81, "result": {"planPrepared": true, "lastValidStep": 2, "stoppedReason": "completed", "perStepResults": [{"stepIndex": 2, "status": "ok", "bodyIds": ["body_op1"]}]}}}
