{"send":{"v":1,"t":"req","id":2,"verb":"ExecutePlan","args":{"jobId":31,"documentRevision":1,"workerEpoch":4,"expectedBaseHash":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","prefixHashes":["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"],"targetStep":1,"ops":[{"opType":"Sketch","opId":"op0","stepIndex":0,"params":{"sketchId":"sk1","plane":{"kind":"XY"},"entities":[{"id":"e1","type":"Line","p0":[0,0],"p1":[10,0]},{"id":"e2","type":"Line","p0":[10,0],"p1":[10,10]},{"id":"e3","type":"Line","p0":[10,10],"p1":[0,10]},{"id":"e4","type":"Line","p0":[0,10],"p1":[0,0]}],"constraints":[]}},{"opType":"Extrude","opId":"op1","stepIndex":1,"inputs":[{"primary":{"bodyId":"","elementId":"sk1.region.r0","kind":"face"}}],"params":{"sketchId":"sk1","distance":10.0,"extrudeMode":"Blind","booleanMode":"NewBody"}}]}}}
{"expect":{"v":1,"t":"event","id":2,"event":"planStep","stepIndex":0,"jobId":31,"payload":{"bodyEvents":[]}}}
{"expect":{"v":1,"t":"event","id":2,"event":"planStep","stepIndex":1,"jobId":31,"payload":{"bodyEvents":[{"kind":"created","bodyId":"body_op1"}]}}}
{"expect":{"v":1,"t":"resp","id":2,"ok":true,"jobId":31,"result":{"planPrepared":true,"lastValidStep":1,"stoppedReason":"completed"}}}
{"send":{"v":1,"t":"req","id":3,"verb":"AcceptPrepared","args":{"jobId":31,"documentRevision":1,"workerEpoch":4}}}
{"expect":{"v":1,"t":"resp","id":3,"ok":true,"jobId":31,"result":{"accepted":true,"snapshotId":1,"documentRevision":1}}}
# One vertical box edge, given a Rust-minted durable identity — the rung the
# frontend uses once an edge has been promoted — and one of its two adjacent faces
# (f:1, the x = 0 wall — this box spans x ∈ [-10, 0], so it is the +X face), because
# since kernel-hardening WP-F (2026-09-04) every
# ASYMMETRIC chamfer must name the face `radius` is measured on as a persisted
# `referenceFaces` pair with the face's ref in `inputs[1]`; a pair-less asymmetric
# record halts `needsRepair` (see chamfer_reference_face_legacy_needsrepair.ndjson).
# f:1 is the face the pre-WP-F smaller-ordinal chooser picked for e:1, so every
# geometry number test_wp6_ops.cpp pins for these rounds is unchanged.
{"send":{"v":1,"t":"req","id":4,"verb":"BindElementIds","args":{"snapshotId":1,"bindings":[{"bodyId":"body_op1","topoKey":"e:1","elementId":"el_edge_v","kind":"edge"},{"bodyId":"body_op1","topoKey":"f:1","elementId":"el_face_ref","kind":"face"}]}}}
{"expect":{"v":1,"t":"resp","id":4,"ok":true,"result":{"bound":[{"bodyId":"body_op1","topoKey":"e:1","elementId":"el_edge_v","kind":"edge"},{"bodyId":"body_op1","topoKey":"f:1","elementId":"el_face_ref","kind":"face"}]}}}
