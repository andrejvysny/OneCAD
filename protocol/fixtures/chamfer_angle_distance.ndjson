{"send":{"v":1,"t":"req","id":8,"verb":"ExecutePlan","args":{"jobId":33,"documentRevision":2,"workerEpoch":4,"expectedBaseHash":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","prefixHashes":["cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"],"targetStep":2,"ops":[{"opType":"Chamfer","opId":"op2","stepIndex":2,"inputs":[{"primary":{"bodyId":"body_op1","elementId":"el_edge_v","kind":"edge"},"anchor":{"worldPoint":[0,0,5]}},{"primary":{"bodyId":"body_op1","elementId":"el_face_ref","kind":"face"},"anchor":{"worldPoint":[0,5,5]}}],"params":{"mode":"Chamfer","radius":1.0,"distance2":2.5,"edgeIds":["el_edge_v"],"chainTangentEdges":true,"tangentClosureVersion":1,"targetBodyId":"body_op1","referenceFaces":[{"edgeId":"el_edge_v","faceId":"el_face_ref"}]}}]}}}
