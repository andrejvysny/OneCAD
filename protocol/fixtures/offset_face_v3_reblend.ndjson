{"expect":{"v":1,"t":"resp","id":4,"ok":true,"result":{"bound":[{"bodyId":"body_op1","topoKey":"f:1","elementId":"el_face_push","kind":"face"},{"bodyId":"body_op1","topoKey":"f:3","elementId":"el_face_blend","kind":"face"},{"bodyId":"body_op1","topoKey":"f:6","elementId":"el_face_support","kind":"face"},{"bodyId":"body_op1","topoKey":"e:2","elementId":"el_blend_edge_a","kind":"edge"},{"bodyId":"body_op1","topoKey":"e:9","elementId":"el_blend_edge_b","kind":"edge"}]}}}
# The V3 push: +2 mm on ONE wall of the frozen three-face closure.
{"send":{"v":1,"t":"req","id":5,"verb":"ExecutePlan","args":{"jobId":32,"documentRevision":2,"workerEpoch":4,"expectedBaseHash":"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc","prefixHashes":["dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"],"targetStep":3,"ops":[{"opType":"OffsetFace","opId":"op3","stepIndex":3,"inputs":[{"primary":{"bodyId":"body_op1","elementId":"el_face_push","kind":"face"},"anchor":{"worldPoint":[0,6,5]}},{"primary":{"bodyId":"body_op1","elementId":"el_face_blend","kind":"face"},"anchor":{"worldPoint":[-1,1,5]}},{"primary":{"bodyId":"body_op1","elementId":"el_face_support","kind":"face"},"anchor":{"worldPoint":[-6,0,5]}}],"params":{"faceIds":["el_face_push","el_face_blend","el_face_support"],"primaryFaceIds":["el_face_push"],"resultPolicyVersion":3,"distance":2.0,"distanceType":"Offset","chainTangentFaces":true,"targetBodyId":"body_op1"}}]}}}
