{"expect":{"v":1,"t":"event","id":5,"event":"planStep","stepIndex":3,"jobId":32,"payload":{"bodyEvents":[{"kind":"modified","bodyId":"body_op1"}],"elementMapDelta":{"relabeled":[{"elementId":"el_face_blend","kind":"face","bodyId":"body_op1","topoKey":"$any"},{"elementId":"el_face_push","kind":"face","bodyId":"body_op1","topoKey":"$any"},{"elementId":"el_face_support","kind":"face","bodyId":"body_op1","topoKey":"$any"}],"removed":["el_blend_edge_a","el_blend_edge_b"]},"signatures":{"geometry":"$hex64"}}}}
