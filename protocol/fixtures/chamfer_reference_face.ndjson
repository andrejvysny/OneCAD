{"send":{"v":1,"t":"req","id":1,"verb":"OpenSession","args":{"documentId":"doc_chamfer_reference_face","documentRevision":0,"workerEpoch":4,"mode":"determinism"}}}
{"expect":{"v":1,"t":"resp","id":1,"ok":true,"result":{"sessionOpen":true}}}
