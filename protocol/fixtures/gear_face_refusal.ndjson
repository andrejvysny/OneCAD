{"send":{"v":1,"t":"req","id":32,"verb":"ExecutePlan","args":{"jobId":92,"documentRevision":2,"workerEpoch":4,"expectedBaseHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","prefixHashes":["dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"],"targetStep":1,"ops":[{"opType":"Fillet","opId":"opgood","stepIndex":1,"inputs":[{"primary":{"bodyId":"body_opgear","elementId":"el_stored_rim","kind":"edge"},"anchor":{"worldPoint":[0.0,5.0,0.0]}}],"params":{"mode":"Fillet","radius":0.2,"edgeIds":["el_stored_rim"],"chainTangentEdges":false,"targetBodyId":"body_opgear"}}]}}}
