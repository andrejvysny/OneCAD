# ladder scores it, so a document written before this build halts with a genuine
# ladder outcome (never a bind, and never a synthesized item) plus the same
# `reasonCode` on the step. The anchor is out at radius 21, on the teeth.
{"send":{"v":1,"t":"req","id":30,"verb":"ExecutePlan","args":{"jobId":91,"documentRevision":2,"workerEpoch":4,"expectedBaseHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","prefixHashes":["cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"],"targetStep":1,"ops":[{"opType":"Fillet","opId":"optooth","stepIndex":1,"inputs":[{"primary":{"bodyId":"body_opgear","elementId":"el_stored_tooth","kind":"edge"},"anchor":{"worldPoint":[21.0,0.0,0.0]}}],"params":{"mode":"Fillet","radius":0.2,"edgeIds":["el_stored_tooth"],"chainTangentEdges":false,"targetBodyId":"body_opgear"}}]}}}
{"expect":{"v":1,"t":"event","id":30,"event":"planStep","stepIndex":1,"jobId":91,"payload":{"bodyEvents":[],"elementMapDelta":{"added":[],"relabeled":[],"removed":[]},"needsRepair":[{"refId":"optooth.input0","elementId":"el_stored_tooth","ladderFailed":"descriptor","reason":"$present","scoringVersion":4}],"diagnostics":[{"severity":"warning","code":"REF_UNRESOLVED","stage":"input-resolution","reasonCode":"GEAR_FACE_NOT_REFERENCEABLE","message":"$present","evidence":{"bodyId":"body_opgear","gearOpId":"opgear","kind":"edge","topoKey":""}}]}}}
{"expect":{"v":1,"t":"resp","id":30,"ok":true,"jobId":91,"result":{"planPrepared":true,"lastValidStep":null,"stoppedReason":"needsRepair","perStepResults":[{"stepIndex":1,"status":"needsRepair","refCount":1}]}}}
