{"expect":{"v":1,"t":"resp","id":6,"ok":false,"error":{"code":"REF_UNRESOLVED","retriable":false,"message":"$present","detail":{"bindingIndex":0,"diagnostics":[{"code":"REF_UNRESOLVED","reasonCode":"GEAR_FACE_NOT_REFERENCEABLE","evidence":{"bodyId":"body_opgear","topoKey":"f:3","gearOpId":"opgear","surfaceType":"other"}}]}}}}
# Nothing was minted: the id the refused bind named does not exist.
{"send":{"v":1,"t":"req","id":7,"verb":"QueryElement","args":{"snapshotId":1,"elementId":"el_flank"}}}
{"expect":{"v":1,"t":"resp","id":7,"ok":true,"result":{"elementId":"el_flank","present":false}}}
# …and the head did not move: field for field the head from id 4.
{"send":{"v":1,"t":"req","id":8,"verb":"GetWorkerHead","args":{}}}
{"expect":{"v":1,"t":"resp","id":8,"ok":true,"result":{"documentRevision":1,"workerEpoch":4,"snapshotId":1,"hasScratch":false,"historyPrefixHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}}
# POSITIVE CONTROLS — the bore and a cap DO bind, in one batch, and both resolve.
{"send":{"v":1,"t":"req","id":9,"verb":"BindElementIds","args":{"snapshotId":1,"bindings":[{"bodyId":"body_opgear","topoKey":"f:123","elementId":"el_bore","kind":"face"},{"bodyId":"body_opgear","topoKey":"f:4","elementId":"el_cap","kind":"face"}]}}}
{"expect":{"v":1,"t":"resp","id":9,"ok":true,"result":{"bound":[{"bodyId":"body_opgear","topoKey":"f:123","elementId":"el_bore","kind":"face"},{"bodyId":"body_opgear","topoKey":"f:4","elementId":"el_cap","kind":"face"}]}}}
{"send":{"v":1,"t":"req","id":10,"verb":"QueryElement","args":{"snapshotId":1,"elementId":"el_bore"}}}
{"expect":{"v":1,"t":"resp","id":10,"ok":true,"result":{"elementId":"el_bore","bodyId":"body_opgear","topoKey":"f:123","kind":"face","present":true}}}
{"send":{"v":1,"t":"req","id":11,"verb":"QueryElement","args":{"snapshotId":1,"elementId":"el_cap"}}}
