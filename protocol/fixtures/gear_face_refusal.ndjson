{"send":{"v":1,"t":"req","id":12,"verb":"ClassifyElement","args":{"elementId":"el_bore"}}}
{"expect":{"v":1,"t":"resp","id":12,"ok":true,"result":{"present":true,"kind":"face","surfaceType":"cylinder","frame":{"origin":"$any","axis":[0.0,0.0,1.0],"radius":5.0,"sidedness":"hole"}}}}
{"send":{"v":1,"t":"req","id":13,"verb":"ClassifyElement","args":{"elementId":"el_cap"}}}
{"expect":{"v":1,"t":"resp","id":13,"ok":true,"result":{"present":true,"kind":"face","surfaceType":"plane","frame":{"origin":"$any","normal":"$any"}}}}
# EDGES AND VERTICES follow their NEIGHBOURHOOD (§7.3): referenceable iff EVERY
# adjacent face is. `e:9` is an involute curve on a cap's OUTER boundary — the cap
# itself binds (id 9 above), but this edge is shared with a tooth flank, so it is
# refused. Its `evidence` carries `kind` where a face refusal carries
# `surfaceType`: what decided it is the neighbourhood, not the edge's own curve.
{"send":{"v":1,"t":"req","id":20,"verb":"BindElementIds","args":{"snapshotId":1,"bindings":[{"bodyId":"body_opgear","topoKey":"e:9","elementId":"el_tooth_edge","kind":"edge"}]}}}
{"expect":{"v":1,"t":"resp","id":20,"ok":false,"error":{"code":"REF_UNRESOLVED","retriable":false,"message":"$present","detail":{"bindingIndex":0,"diagnostics":[{"code":"REF_UNRESOLVED","reasonCode":"GEAR_FACE_NOT_REFERENCEABLE","evidence":{"bodyId":"body_opgear","topoKey":"e:9","gearOpId":"opgear","kind":"edge"}}]}}}}
{"send":{"v":1,"t":"req","id":21,"verb":"QueryElement","args":{"snapshotId":1,"elementId":"el_tooth_edge"}}}
{"expect":{"v":1,"t":"resp","id":21,"ok":true,"result":{"elementId":"el_tooth_edge","present":false}}}
# …and the head still has not moved: field for field the head from id 4.
{"send":{"v":1,"t":"req","id":22,"verb":"GetWorkerHead","args":{}}}
{"expect":{"v":1,"t":"resp","id":22,"ok":true,"result":{"documentRevision":1,"workerEpoch":4,"snapshotId":1,"hasScratch":false,"historyPrefixHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}}
# POSITIVE CONTROL — the BORE RIM circle (`e:128`) binds: every face around it is
