{"send":{"v":1,"t":"req","id":23,"verb":"BindElementIds","args":{"snapshotId":1,"bindings":[{"bodyId":"body_opgear","topoKey":"e:128","elementId":"el_bore_rim","kind":"edge"}]}}}
{"expect":{"v":1,"t":"resp","id":23,"ok":true,"result":{"bound":[{"bodyId":"body_opgear","topoKey":"e:128","elementId":"el_bore_rim","kind":"edge"}]}}}
{"send":{"v":1,"t":"req","id":24,"verb":"QueryElement","args":{"snapshotId":1,"elementId":"el_bore_rim"}}}
{"expect":{"v":1,"t":"resp","id":24,"ok":true,"result":{"elementId":"el_bore_rim","bodyId":"body_opgear","topoKey":"e:128","kind":"edge","present":true}}}
{"send":{"v":1,"t":"req","id":25,"verb":"ClassifyElement","args":{"elementId":"el_bore_rim"}}}
{"expect":{"v":1,"t":"resp","id":25,"ok":true,"result":{"present":true,"kind":"edge","curveType":"circle","frame":{"origin":"$any","axis":"$any","radius":5.0}}}}
# THE PLAN-STEP RUNG. Everything above is `BindElementIds`; the §7.3 rule also
# runs where a STORED ref resolves inside an `ExecutePlan` — and there it works
