# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Cargo (root workspace; keep legacy outputs ignored)
/target/
/crates/*/target/
src-tauri/target
src-tauri/gen/schemas
# Standalone migration investigations retain source and evidence, not Cargo outputs.
spikes/*/target/

# Xcode DerivedData for the iPad host (xcodebuild -derivedDataPath build/DerivedData).
/build/

# Bundled worker sidecar binaries (produced by scripts/build-worker.sh)
packaging/binaries/

# C++ worker build trees — `worker/build` is the default; alternates come from
# ONECAD_WORKER_BUILD_DIR (e.g. `worker/build-pinned` for a pinned-OCCT build,
# `worker/build-8.0.1-rust` in CI).
worker/build
worker/build-*

# Playwright CLI session artifacts (screenshots/logs from manual verification)
.playwright-cli/

# Playwright e2e outputs
test-results/
playwright-report/
blob-report/
.playwright/
e2e-tauri/results/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# graphify knowledge graph (rebuild locally: /graphify .)
graphify-out/

# Agent tooling and scratch inputs are not project source.
.agents/
.opencode/
skills-lock.json

# Sample CAD exports used for manual import testing.
# `STEP/*` and not `STEP/`: git never descends into an excluded DIRECTORY, so
# the negation below would have no effect under the directory form.
STEP/*
# …except the ingest recipe: the vendor STEP files are downloads, but the
# keep-lists authored against them (and the evidence for each) are source.
!STEP/ingest.toml

# Local-only gear cross-check harness run artifacts (scripts/gear-crosscheck).
__pycache__/

# Agent definitions are project source; machine-local state is not.
.claude/settings.local.json
.claude/RESUME.md

# tauri-agent MCP harness artifacts
.tauri-agent/
# skill-creator eval workspace (transcripts, screenshots)
.claude/skills/onecad-agent-test-workspace/

# Retired setup and duplicated management ledgers are rejected by cargo xtask check-hygiene.
/src-tauri/
/tools/tauri-agent/
/PLAN.md
/TODO.md
/HANDOFF.md
/CURRENT_STATE.md
/package.json
/bun.lock
/tsconfig.json
