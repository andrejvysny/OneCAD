// Chrome panels styled from tokens.css (dark): body tree, inspector, status bar, toolbars.
import { Tokens } from "tokens.slint";
import { Icon, Icons, IconDef } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

export global Theme {
    in property <string> mono-font: ".SF NS Mono";
}

export struct BodyRow {
    name: string,
    visible: bool,
    selected: bool,
}

component SectionHeader inherits Rectangle {
    in property <string> text;
    height: 32px;
    Text {
        x: 14px;
        y: 12px;
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.8px;
        color: Tokens.ink-5;
        accessible-role: AccessibleRole.text;
    }
}

component TreeRow inherits Rectangle {
    in property <string> name;
    in property <bool> shown;
    in property <bool> selected;
    callback select();
    callback toggle-visible();
    height: 33px;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.name;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.select(); }
    touch := TouchArea {
        clicked => { root.select(); }
    }
    Rectangle {
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: 32px;
        border-radius: 6px;
        background: root.selected ? Tokens.sel-bg : touch.has-hover ? Tokens.hover-2 : transparent;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 6px;
            spacing: 8px;
            alignment: stretch;
            Icon {
                icon: Icons.body;
                size: 15px;
                y: (parent.height - self.height) / 2;
                color: root.selected ? Tokens.sel-text : Tokens.ink-4;
                accent: self.color;
            }
            Text {
                text: root.name;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                color: root.selected ? Tokens.sel-text : Tokens.tree-label;
                opacity: root.shown ? 1.0 : 0.5;
            }
            eye := Rectangle {
                width: 22px;
                accessible-role: AccessibleRole.checkbox;
                accessible-label: "Toggle " + root.name + " visibility";
                accessible-checked: root.shown;
                accessible-action-default => { root.toggle-visible(); }
                Icon {
                    icon: root.shown ? Icons.eye : Icons.eye-off;
                    size: 14px;
                    color: eye-touch.has-hover ? Tokens.ink-2 : Tokens.ink-5;
                    accent: root.shown ? Tokens.icon-accent : Tokens.ink-6;
                    stroke: 1.5px;
                }
                eye-touch := TouchArea {
                    clicked => { root.toggle-visible(); }
                }
            }
        }
    }
}

export component BodyTree inherits Rectangle {
    in property <[BodyRow]> bodies;
    callback body-clicked(int);
    callback body-toggle(int);
    background: Tokens.panel;
    accessible-role: AccessibleRole.tree;
    accessible-label: "Model tree";
    ScrollView {
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            SectionHeader { text: "BODIES"; }
            for row[i] in root.bodies: TreeRow {
                name: row.name;
                shown: row.visible;
                selected: row.selected;
                select => { root.body-clicked(i); }
                toggle-visible => { root.body-toggle(i); }
            }
            SectionHeader { text: "SKETCHES"; }
            SectionHeader { text: "DATUMS"; }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tokens.border;
    }
}

component PropRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    padding-left: 14px;
    padding-right: 14px;
    height: 26px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + " " + root.value;
    Text {
        text: root.label;
        font-size: 12px;
        color: Tokens.ink-4;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Text {
        text: root.value;
        font-size: 11.5px;
        font-family: Theme.mono-font;
        color: Tokens.ink-2;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

export component Inspector inherits Rectangle {
    in property <string> name;
    in property <[{label: string, value: string}]> props;
    in property <[string]> history;
    background: Tokens.panel;
    accessible-role: AccessibleRole.complementary;
    accessible-label: "Inspector";
    Rectangle {
        x: 0px;
        width: 1px;
        background: Tokens.border;
    }
    if root.name == "": VerticalLayout {
        alignment: start;
        padding-top: 44px;
        spacing: 6px;
        Rectangle {
            height: 34px;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: Tokens.chip;
                Icon {
                    icon: Icons.select;
                    size: 15px;
                    color: Tokens.ink-4;
                    accent: Tokens.ink-4;
                }
            }
        }
        Text {
            text: "Nothing selected";
            font-size: 13px;
            font-weight: 600;
            color: Tokens.ink-2;
            horizontal-alignment: center;
        }
        Text {
            text: "Select a body, sketch, face or edge\nto see its parameters and history.";
            font-size: 12px;
            color: Tokens.ink-5;
            horizontal-alignment: center;
        }
    }
    if root.name != "": VerticalLayout {
        alignment: start;
        padding-top: 14px;
        spacing: 2px;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            height: 30px;
            Icon {
                icon: Icons.body;
                size: 16px;
                y: (parent.height - self.height) / 2;
                color: Tokens.ink-2;
            }
            Text {
                text: root.name;
                font-size: 13px;
                font-weight: 600;
                color: Tokens.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        SectionHeader { text: "PROPERTIES"; }
        for p in root.props: PropRow {
            label: p.label;
            value: p.value;
        }
        SectionHeader { text: "DIMENSION HISTORY"; }
        for h in root.history: PropRow {
            label: "commit";
            value: h;
        }
    }
}

export component ToolButton inherits Rectangle {
    in property <IconDef> icon;
    in property <bool> active;
    in property <string> label;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: root.active ? Tokens.sel-bg : t.has-hover ? Tokens.hover : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon {
        icon: root.icon;
        size: 17px;
        stroke: 1.7px;
        color: root.active ? Tokens.sel-text : Tokens.ink-3;
        accent: root.active ? Tokens.sel-text : Tokens.icon-accent;
    }
    t := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Separator inherits Rectangle {
    width: 9px;
    Rectangle {
        width: 1px;
        height: 20px;
        background: Tokens.border;
    }
}

export component FloatingToolbar inherits Rectangle {
    in property <int> active: 0;
    callback tool(int);
    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Tokens.scrim;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "Tools";
    width: tools.preferred-width;
    height: tools.preferred-height;
    tools := HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        ToolButton { icon: Icons.select; label: "Select"; active: root.active == 0; clicked => { root.tool(0); } }
        ToolButton { icon: Icons.sketch; label: "Sketch"; active: root.active == 1; clicked => { root.tool(1); } }
        ToolButton { icon: Icons.plane; label: "Plane"; active: root.active == 2; clicked => { root.tool(2); } }
        Separator { }
        ToolButton { icon: Icons.extrude; label: "Extrude"; active: root.active == 3; clicked => { root.tool(3); } }
        ToolButton { icon: Icons.revolve; label: "Revolve"; active: root.active == 4; clicked => { root.tool(4); } }
        ToolButton { icon: Icons.fillet; label: "Fillet"; active: root.active == 5; clicked => { root.tool(5); } }
        ToolButton { icon: Icons.chamfer; label: "Chamfer"; active: root.active == 6; clicked => { root.tool(6); } }
        Separator { }
        ToolButton { icon: Icons.shell; label: "Shell"; active: root.active == 7; clicked => { root.tool(7); } }
        ToolButton { icon: Icons.boolean; label: "Combine"; active: root.active == 8; clicked => { root.tool(8); } }
        ToolButton { icon: Icons.pattern; label: "Pattern"; active: root.active == 9; clicked => { root.tool(9); } }
        ToolButton { icon: Icons.mirror; label: "Mirror"; active: root.active == 10; clicked => { root.tool(10); } }
        ToolButton { icon: Icons.move; label: "Move"; active: root.active == 11; clicked => { root.tool(11); } }
        Separator { }
        ToolButton { icon: Icons.measure; label: "Measure"; active: root.active == 12; clicked => { root.tool(12); } }
    }
}

export component NavPill inherits Rectangle {
    callback home();
    callback fit();
    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "Navigation";
    width: nav.preferred-width;
    height: nav.preferred-height;
    nav := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        ToolButton { icon: Icons.home; label: "Home view"; clicked => { root.home(); } }
        ToolButton { icon: Icons.fit; label: "Fit all"; clicked => { root.fit(); } }
        ToolButton { icon: Icons.iso; label: "Isometric"; clicked => { root.home(); } }
        ToolButton { icon: Icons.stack; label: "Layers"; }
    }
}

component StatusSep inherits Rectangle {
    width: 1px;
    height: 14px;
    background: Tokens.border;
}

component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked;
    width: txt.preferred-width + 22px;
    height: 22px;
    border-radius: 4px;
    background: root.on ? Tokens.sel-bg : transparent;
    accessible-role: AccessibleRole.radio-button;
    accessible-label: root.text;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    txt := Text {
        text: root.text;
        font-size: 11.5px;
        font-weight: 600;
        color: root.on ? Tokens.sel-text : Tokens.ink-4;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component StatusBar inherits Rectangle {
    in property <string> status;
    in property <bool> ortho;
    in property <string> fov;
    in property <string> cursor;
    callback set-ortho(bool);
    height: 34px;
    background: Tokens.statusbar;
    accessible-role: AccessibleRole.content-info;
    accessible-label: "Status bar";
    Rectangle {
        y: 0px;
        height: 1px;
        background: Tokens.border;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: stretch;
        Text { text: root.status; font-size: 12px; color: Tokens.ink-3; vertical-alignment: center; }
        StatusSep { y: 10px; }
        Text { text: "DOF: —"; font-size: 12px; font-weight: 500; color: Tokens.ink-4; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 2px;
            padding-top: 6px;
            padding-bottom: 6px;
            Segment { text: "Persp"; on: !root.ortho; clicked => { root.set-ortho(false); } }
            Segment { text: "Ortho"; on: root.ortho; clicked => { root.set-ortho(true); } }
        }
        Text { text: root.fov; font-size: 11.5px; color: Tokens.ink-5; vertical-alignment: center; }
        StatusSep { y: 10px; }
        Text {
            text: root.cursor;
            font-size: 11.5px;
            font-family: Theme.mono-font;
            color: Tokens.ink-3;
            vertical-alignment: center;
            accessible-role: AccessibleRole.text;
            accessible-label: "Cursor position";
        }
    }
}
