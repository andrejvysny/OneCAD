{
  "build": {
    "beforeDevCommand": "VITE_TAURI_E2E=1 bun run dev",
    "devUrl": "http://localhost:1420/?vpdebug&trace"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "tauri-e2e",
          "description": "WebdriverIO bridge for the agent-driven dev session only",
          "windows": [
            "main"
          ],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
