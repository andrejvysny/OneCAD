{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "rm *": "deny",
      "grep *": "allow",
      "cargo test *": "allow",
      "cargo build *": "allow",
      "cargo fmt *": "allow",
      "cargo clippy *": "allow",
      "bunx tsc --noEmit": "allow",
      "bun run test *": "allow",
      "bun run build *": "allow",
      "bun run e2e *": "allow",
      "wc *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cd *": "allow"
    },
    "edit": "allow"
  }
}