+/**
+ * The crash window that boot-only recovery cannot see.
+ *
+ * `expireStaleLeases` is the only evidence a process died mid-attempt, but it
+ * can only report a lease that still EXISTS. A recovery pass deletes the lease,
+ * ends the attempt, and then — if the process dies before re-dispatching — the
+ * task is left `running` with no lease at all. Every later expiry sweep finds
+ * nothing, the chat stays busy, and cancellation has no local execution to
+ * abort. Before the orphan sweep the only record of that task was an in-memory
+ * set, which the crash took with it.
+ *
+ * Driven by the injected clock; the only real waits are condition polls.
+ */
+import { describe, expect, it } from "bun:test";
+import {
+  createHarness,
+  settle,
+  waitFor,
+  type Harness,
+} from "./support/task-runner-harness.js";
+
+describe("SingleProcessTaskRunner — orphan sweep", () => {
+
+  /** A `running` task with no lease — what a crash mid-recovery leaves behind. */
+  async function seedOrphan(h: Harness, taskId: string): Promise<void> {
+    await h.seedTask(taskId);
+    await h.store.tasks.createAttempt({
+      attemptId: `${taskId}-att-1`,
+      taskId,
+      ownerId: "owner-that-died",
+    });
+    await h.store.tasks.transitionTask(taskId, ["queued"], "running");
+    // No lease is acquired at all: that is the whole point.
+  }
+
+  it("recovers a running task that holds no lease, with no explicit recover()", async () => {
+    const harness = createHarness({ leaseTtlMs: 1_000, pollMs: 5 });
+    await seedOrphan(harness, "orphan-1");
+    harness.worker.script("orphan-1", [{ kind: "complete" }]);
+
+    const handle = await harness.runner.startWorker(harness.worker, {
+      concurrency: 1,
+      ownerId: "owner-new",
+    });
+    try {
+      // Push past the sweep interval (half the lease TTL by default) without
+      // ever calling recover(). The point is that NOTHING prompts this.
+      harness.clock.advance(1_000);
+      await waitFor(
+        async () =>
+          (await harness.store.tasks.getTask("orphan-1"))?.status === "completed",
+        "the orphan to be swept up and completed",
+      );
+      expect(harness.worker.callsFor("orphan-1").length).toBe(1);
+    } finally {
+      await handle.stop();
+    }
+  });
+
+  it("leaves a task alone while another owner still holds its lease", async () => {
+    // "No lease" means nobody's. A lease — live OR expired — means somebody's,
+    // and expiry is `recover()`'s business, not a timer's.
+    const harness = createHarness({ leaseTtlMs: 1_000, pollMs: 5 });
+    await harness.seedTask("held-1");
+    const attempt = await harness.store.tasks.createAttempt({
+      attemptId: "held-1-att-1",
+      taskId: "held-1",
+      ownerId: "somebody-else",
+    });
+    await harness.store.tasks.transitionTask("held-1", ["queued"], "running");
+    await harness.store.tasks.acquireLease({
