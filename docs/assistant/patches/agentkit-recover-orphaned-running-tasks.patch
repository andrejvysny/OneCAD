+  async selectOrphanedRunningTasks(limit: number): Promise<TaskRecord[]> {
+    if (limit <= 0) return [];
+    // "No lease at all", never "an expired lease": a task that still holds one
+    // belongs to whoever took it, and the expiry sweep is what settles that
+    // case. Reporting both here would put two recoverers on one task.
+    const orphans: TaskRecord[] = [];
